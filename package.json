{
  "name": "wreckmatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "wreckmatch:check": "node scripts/check-wreckmatch-setup.mjs",
    "deploy": "npm run build && vercel --prod",
    "blog:generate": "node scripts/generate-blog-batch.mjs",
    "bobbygarcia:blog:generate": "node scripts/generate-bobbygarcia-bulk.mjs",
    "bobbygarcia:blog:generate:force": "node scripts/generate-bobbygarcia-bulk.mjs --clean --force",
    "bobbygarcia:pptx": "node scripts/generate-bobbygarcia-pptx.mjs",
    "bobbygarcia:images": "node scripts/download-bobbygarcia-images.mjs",
    "bobbygarcia:blog:covers": "node scripts/download-bobbygarcia-blog-covers.mjs",
    "bobbygarcia:blog:covers:force": "node scripts/download-bobbygarcia-blog-covers.mjs --force",
    "bobbygarcia:blog:curate": "node scripts/curate-bobbygarcia-blogs.mjs",
    "bobbygarcia:blog:expand": "node scripts/expand-bobbygarcia-posts.mjs",
    "bobbygarcia:blog:polish": "node scripts/polish-bobbygarcia-posts.mjs",
    "bobbygarcia:blog:full": "node scripts/polish-bobbygarcia-posts.mjs && node scripts/generate-bobbygarcia-pptx.mjs --force",
    "seo:cannibalization": "node scripts/find-cannibalization.mjs",
    "seo:quality-gate": "node scripts/quality-gate.mjs",
    "seo:verify": "node scripts/verify-seo-live.mjs",
    "seo:checklist": "node scripts/seo-post-domain-checklist.mjs",
    "seo:daily": "node scripts/seo-daily.mjs --indexnow",
    "seo:enrichment": "node scripts/enrichment-status.mjs",
    "seo:autopilot": "node scripts/autopilot-status.mjs",
    "seo:agent": "node scripts/seo-agent.mjs rotate",
    "seo:agent:loop": "bash scripts/run-seo-agent-loop.sh",
    "seo:agent:status": "node scripts/agent-status.mjs",
    "seo:ping-feeds": "node scripts/ping-feeds.mjs",
    "seo:validate-sitemaps": "node scripts/validate-sitemaps.mjs",
    "seo:generate-cities": "npx tsx scripts/generate-enriched-city-markdown.ts",
    "seo:generate-programmatic": "npx tsx scripts/generate-programmatic-seo-geo.ts",
    "seo:generate-blogs-all": "npx tsx scripts/generate-programmatic-seo-geo.ts --blogs-only --all-cities",
    "seo:generate-blogs-all:publish": "npx tsx scripts/generate-programmatic-seo-geo.ts --blogs-only --all-cities && npm run seo:quality-gate && node scripts/indexnow-after-content.mjs --wait-deploy --recent",
    "seo:indexnow": "node scripts/submit-indexnow.mjs all --fallback",
    "seo:indexnow:publish": "node scripts/indexnow-after-content.mjs --wait-deploy --recent",
    "geo:run": "python3 scripts/geo_automation.py --notify-all-prod",
    "geo:audit": "node scripts/geo-audit-url.mjs",
    "marketing:attorneys:plan": "node scripts/attorney-email-campaign.mjs --output content/marketing/attorney-email-campaign-preview.json",
    "marketing:attorneys:send": "node scripts/attorney-email-campaign.mjs --provider=resend --send --confirm=SEND_ATTORNEY_CAMPAIGN",
    "marketing:attorneys:send:ghl": "node scripts/attorney-email-campaign.mjs --provider=ghl --send --confirm=SEND_ATTORNEY_CAMPAIGN",
    "blog:enrich-drafts": "npx tsx scripts/enrich-blog-drafts.ts",
    "blog:enrich-publish": "npx tsx scripts/enrich-blog-drafts.ts --publish",
    "autopilot:build-cities": "python3 scripts/build_cities_master.py",
    "autopilot:next": "python3 scripts/accident_survival_guide_autopilot.py --next --publish-json",
    "autopilot:batch": "python3 scripts/accident_survival_guide_autopilot.py --batch 20 --publish-json --continue-on-error",
    "autopilot:all": "bash scripts/run_autopilot_all.sh",
    "autopilot:sync": "python3 scripts/accident_survival_guide_autopilot.py --sync-queue",
    "autopilot:trigger": "bash scripts/trigger-bulk-workflow.sh",
    "autopilot:city": "python3 scripts/accident_survival_guide_autopilot.py --city Austin --state Texas --publish-json",
    "blog:export-cities": "npx tsx -e \"import { US_CITIES } from './src/lib/blog/cities.ts'; import fs from 'fs'; fs.writeFileSync('content/blog/cities-seed.json', JSON.stringify(US_CITIES, null, 2));\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "^14.2.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
