# Copy to .env.secrets and fill in (never commit .env.secrets — covered by .gitignore)
# Then: gh auth login && bash scripts/setup-github-secrets.sh

OPENAI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
INDEXNOW_KEY=wreckmatch-indexnow-key

# Attorney campaign sending (Resend)
RESEND_API_KEY=
ATTORNEY_CAMPAIGN_PROVIDER=resend
ATTORNEY_CAMPAIGN_FROM="WreckMatch Partner Team <partnerships@partners.wreckmatch.com>"
ATTORNEY_CAMPAIGN_REPLY_TO=partnerships@partners.wreckmatch.com
ATTORNEY_CAMPAIGN_UNSUBSCRIBE_URL=https://www.wreckmatch.com/unsubscribe
ATTORNEY_CAMPAIGN_UNSUBSCRIBE_WEBHOOK_URL=
ATTORNEY_CAMPAIGN_PHYSICAL_ADDRESS=
ATTORNEY_CAMPAIGN_WARMUP_START=2026-06-16
ATTORNEY_CAMPAIGN_MAX_DAILY=800

# Optional GHL fallback
ATTORNEY_CAMPAIGN_WEBHOOK_URL=
